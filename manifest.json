{
  "manifest_version": 3,
  "name": "Bundlex AI Studio",
  "version": "1.0.0",
  "description": "Multi-model workspace featuring customized AI agents, knowledge base, real-time web search, voice tools, and local storage.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Bundlex AI Studio"
  },
  "background": {
    "service_worker": "background.js"
  }
}